@book{deOliveira2023,
  title = {{Discurso filos\'ofico da acumula\c c\~ao primitiva: estudos sobre as origens do pensamento moderno}},
  shorttitle = {{Discurso filos\'ofico da acumula\c c\~ao primitiva}},
  author = {{de Oliveira}, Pedro Rocha},
  year = 2023,
  month = aug,
  publisher = {Editora Elefante},
  address = {S\~ao Paulo},
  abstract = {O conceito de uma ci\^encia eficaz, baseada na evid\^encia dos experimentos; a utopia pol\'itico-filos\'ofica e o Estado administrativamente capaz; a no\c c\~ao de sociedade civil e a funcionalidade da economia baseada no benef\'icio pr\'oprio. Tais ideias, ainda hoje fundamentais para a compreens\~ao da sociedade capitalista, foram formuladas pela primeira vez no per\'iodo particularmente brutal da ``assim chamada acumula\c c\~ao primitiva de capital'': as origens da modernidade. Os pioneiros que ent\~ao as propuseram, longe de serem pensadores profissionais, eram membros bastante ativos da elite pol\'itico-econ\^omica: cortes\~aos habilidosos, aristocratas favorecidos, representantes eleitos das classes propriet\'arias, inimigos ferrenhos das rebeli\~oes populares. Francis Bacon, advogado e terratenente, supervisionava torturas; Thomas More, o conselheiro humanista de Henrique VIII, tinha um pelourinho no jardim; Thomas Smith, o que primeiro escreveu ``sociedade civil'' em ingl\^es, engajou-se pessoalmente na genocida coloniza\c c\~ao da Irlanda. O presente trabalho prop\~oe uma ``leitura a contrapelo'' das obras de autores paradigm\'aticos, visando desrecalcar o conte\'udo hist\'orico, econ\^omico e social de seu pensamento, mostrando a inc\^omoda continuidade que existe entre a mais alta imagina\c c\~ao moderna e a viol\^encia do processo civilizat\'orio capitalista. Trata-se de uma an\'alise detalhada de textos-chave de Francis Bacon, Thomas More e Thomas Smith, homens do ``longo s\'eculo XVI'', buscando reconstruir passo a passo a l\'ogica de suas exposi\c c\~oes, ao mesmo tempo permitindo que os acontecimentos e a atmosfera de seu contexto hist\'orico se insinuem entre os argumentos, de modo que possam ser compreendidos em sua densidade real. Para tanto, s\~ao mobilizados documentos de \'epoca, bem como explana\c c\~oes a respeito do funcionamento da sociedade na qual os autores viveram. Indaga-se qual o significado dos textos para os leitores que lhes eram contempor\^aneos, n\~ao s\'o numa perspectiva cognitiva, mas do ponto de vista das implica\c c\~oes pol\'iticas neles contidas.},
  langid = {brazilian},
  keywords = {economics,philosophy}
}

@article{Duayer2008,
  title = {{Marx, estranhamento e emancipa\c c\~ao: o car\'ater subordinado da categoria da explora\c c\~ao na an\'alise marxiana da sociedade do capital}},
  shorttitle = {{Marx, estranhamento e emancipa\c c\~ao}},
  author = {Duayer, Mario and Medeiros, Jo{\~a}o Leonardo},
  year = 2008,
  month = dec,
  journal = {Revista de Economia},
  volume = {34},
  number = {4},
  url = {http://revistas.ufpr.br/economia/article/view/17173},
  urldate = {2026-03-07},
  abstract = {A melhor forma de celebrar os 140 anos da publica\c c\~ao da obraprimade Marx, O Capital, \'e indubitavelmente recuperar o seu sentido originalde cr\'itica cient\'ifica das condi\c c\~oes sociais que, de um lado, criam as condi\c c\~oesmateriais para e, de outro, impedem a realiza\c c\~ao da emancipa\c c\~ao humana:a sociedade regida pelo capital. E isso porque o nexo entre cr\'itica cient\'ificae emancipa\c c\~ao humana perdeu-se, no s\'eculo XX, em meio a uma atmosferaque combinou um crescente recrudescimento do pensamento conservadorcom o descr\'edito das vers\~oes vulgarizadas do pensamento de Marx que amparavamas experi\^encias do socialismo real no plano subjetivo. Para superar apesada heran\c ca deste per\'iodo e restaurar aquele sentido fundamental de OCapital, \'e imprescind\'ivel recuperar seu argumento desde o ponto de partidaassumido pelo pr\'oprio autor: a an\'alise da circula\c c\~ao de mercadorias e dasformas de consci\^encia, inclusive cient\'ificas, a ela associadas.},
  langid = {portuguese},
  keywords = {marxism}
}

