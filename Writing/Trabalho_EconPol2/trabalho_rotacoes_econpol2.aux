\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Cada quadrado representa três semanas; os quadrados hachurados em verde e em amarelo se tratam de trimestres \textit  {ativamente em produção}: em verde são os que são empregados no primeiro período de trabalho, e o em amarelo é o que capital ``adicional'' que é empregado a partir do segundo período de trabalho; os quadrados hachurados em preto são períodos em que o capital produzido está \textit  {em circulação}.}}{6}{figure.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Segundo exemplo: rotação de 10 semanas (tempo de trabalho igual ao tempo de circulação)}{6}{subsection.3.2}\protected@file@percent }
